# Optional: the default uses your locally installed, authenticated Codex CLI.
# Copy this file to .env only if you need to change settings. Never commit .env.
# Supported values: codex, openai. Failures never switch providers automatically.
EMPLOYMENT_AGENT_PROVIDER=codex

# Codex mode only. Leave blank to use your existing Codex model configuration.
# Install the official CLI and complete codex login yourself if needed.
# The app never reads/copies auth.json or starts a login flow.
CODEX_MODEL=

# Optional, direct OpenAI API mode only. Codex mode does not use this setting.
# You can instead enter an API key for a single request in the API-mode UI.
OPENAI_API_KEY=

# Direct API mode only. Requires Responses API, web_search, structured outputs,
# and model access for your API account. This does not select a Codex model.
OPENAI_MODEL=gpt-5.5
